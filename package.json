{
  "name": "@fishonfire/bubbles-js",
  "version": "0.1.0",
  "description": "Zero-dependency client for creating and updating devices via an HTTP API.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "npm pack --dry-run --cache .npm-cache",
    "lint": "eslint . --ext .js,.cjs,.ts --max-warnings 0",
    "test": "node --test",
    "lint:fix": "npm run lint -- --fix"
  },
  "keywords": [
    "api-client",
    "device",
    "fetch",
    "npm-package"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "eslint": "^8.57.1",
    "eslint-plugin-sonarjs": "^0.19.0",
    "typescript": "~5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
